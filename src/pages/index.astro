---
// Peak rates apply Monday–Friday, 01:00–04:00 and 06:00–10:00 UTC.
// Off-peak rates are half the peak rates.
import "../styles/index.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>DeepSeek Peak Hours</title>
  </head>
  <body>
    <canvas id="gradient-canvas"></canvas>

    <div class="content">
      <p class="status-label text-outline" id="status-label">Checking time…</p>
      <h1 class="main-heading" id="main-heading">—</h1>
      <div class="countdown" id="countdown">
        <p class="countdown-label" id="countdown-label">—</p>
        <p class="countdown-time" id="countdown-time">—</p>
      </div>
      <button class="toggle-info" id="toggle-info" aria-label="Show time info"
        >ℹ</button
      >
      <div class="time-info hidden" id="time-info">
        <p class="peak-schedule" id="peak-schedule">
          Peak hours: 01:00–04:00 · 06:00–10:00 UTC (Monday–Friday)
        </p>
        <p class="rate-policy">Off-peak rates: 50% of peak rates</p>
        <p class="peak-schedule local" id="local-peak">—</p>
        <p class="clock" id="clock">UTC time: —</p>
        <p class="clock local" id="local-clock">Local time: —</p>
        <p class="tz-note" id="tz-note" title="Click to change timezone"></p>
      </div>

      <!-- Timezone selector modal -->
      <div
        class="tz-backdrop hidden"
        id="tz-backdrop"
        role="dialog"
        aria-label="Select timezone"
      >
        <div class="tz-popover" id="tz-popover">
          <input
            type="text"
            class="tz-search"
            id="tz-search"
            placeholder="Search timezone…"
            autocomplete="off"
          />
          <div class="tz-list" id="tz-list"></div>
        </div>
      </div>
    </div>

    <script>
      import Fuse from "fuse.js";
      import { GradientCanvas } from "../lib/canvas-gradient";
      import {
        formatCountdown,
        getUtcTimeString,
        getCountdownInfo,
        getLocalPeakHoursString,
        getLocalTimeString,
        getLocalTZString,
        getOffsetForZone,
        getStoredTimezone,
        getUserTimezone,
        isPeakHours,
        setStoredTimezone,
      } from "../lib/peak-hours";

      /* ── DOM refs ──────────────────────────────────────────────────── */
      const canvasEl = document.getElementById(
        "gradient-canvas",
      ) as HTMLCanvasElement;
      const labelEl = document.getElementById("status-label")!;
      const headingEl = document.getElementById("main-heading")!;
      const countdownEl = document.getElementById("countdown") as HTMLElement;
      const countdownLabelEl = document.getElementById("countdown-label")!;
      const countdownTimeEl = document.getElementById("countdown-time")!;
      const clockEl = document.getElementById("clock") as HTMLElement;
      const localClockEl = document.getElementById(
        "local-clock",
      ) as HTMLElement;
      const tzNoteEl = document.getElementById("tz-note") as HTMLElement;
      const localPeakEl = document.getElementById("local-peak") as HTMLElement;
      const toggleBtn = document.getElementById(
        "toggle-info",
      ) as HTMLButtonElement;
      const timeInfo = document.getElementById("time-info") as HTMLElement;

      /* ── Info toggle ──────────────────────────────────────────────────── */
      toggleBtn.addEventListener("click", () => {
        const wasHidden = timeInfo.classList.toggle("hidden");
        toggleBtn.textContent = wasHidden ? "ℹ" : "✕";
        toggleBtn.setAttribute(
          "aria-label",
          wasHidden ? "Show time info" : "Hide time info",
        );
      });

      /* ── Timezone selector ─────────────────────────────────────────── */
      const tzBackdrop = document.getElementById("tz-backdrop") as HTMLElement;
      const tzSearch = document.getElementById("tz-search") as HTMLInputElement;
      const tzList = document.getElementById("tz-list") as HTMLElement;

      interface TZEntry {
        zone: string;
        offset: number;
        offsetLabel: string;
      }

      let tzEntries: TZEntry[] = [];
      let tzFuse: Fuse<TZEntry>;

      function buildTimezoneList(): void {
        const zones = Intl.supportedValuesOf("timeZone");
        tzEntries = zones
          .map((zone) => ({
            zone,
            offset: getOffsetForZone(zone),
            offsetLabel: "",
          }))
          .map((e) => ({ ...e, offsetLabel: formatOffsetLabel(e.offset) }))
          .sort((a, b) => a.offset - b.offset || a.zone.localeCompare(b.zone));

        tzFuse = new Fuse(tzEntries, {
          keys: ["zone", "offsetLabel"],
          threshold: 0.4,
          minMatchCharLength: 2,
          ignoreLocation: true,
        });
      }

      function formatOffsetLabel(offset: number): string {
        const sign = offset >= 0 ? "+" : "−";
        const ah = String(Math.floor(Math.abs(offset) / 60)).padStart(2, "0");
        const am = String(Math.abs(offset) % 60).padStart(2, "0");
        return am === "00" ? `UTC${sign}${ah}:00` : `UTC${sign}${ah}:${am}`;
      }

      function renderTZList(filter = ""): void {
        const activeZone = getUserTimezone();
        const q = filter.toLowerCase().trim();

        tzList.innerHTML = "";

        // "Auto-detect" row always first
        const autoRow = document.createElement("button");
        autoRow.className =
          "tz-option" + (getStoredTimezone() ? "" : " tz-selected");
        autoRow.type = "button";
        autoRow.innerHTML = `<span>Auto-detect</span><span class="tz-check">✓</span>`;
        autoRow.addEventListener("click", () => selectTimezone(null));
        tzList.appendChild(autoRow);

        const matching = q ? tzFuse.search(q).map((r) => r.item) : tzEntries;

        for (const entry of matching) {
          const row = document.createElement("button");
          row.className =
            "tz-option" + (entry.zone === activeZone ? " tz-selected" : "");
          row.type = "button";
          const city = entry.zone.split("/").pop()!.replace(/_/g, " ");
          row.innerHTML = `<span>${city}</span><span class="tz-offset">${entry.offsetLabel}</span><span class="tz-check">✓</span>`;
          row.addEventListener("click", () => selectTimezone(entry.zone));
          tzList.appendChild(row);
        }
      }

      function selectTimezone(zone: string | null): void {
        setStoredTimezone(zone);
        closeTZModal();
        refreshTimeDisplay();
      }

      function refreshTimeDisplay(): void {
        tzNoteEl.textContent = getLocalTZString();
        localClockEl.textContent = `Local time: ${getLocalTimeString()}`;
        localPeakEl.textContent = getLocalPeakHoursString();
      }

      function openTZModal(): void {
        tzBackdrop.classList.remove("hidden");
        tzSearch.value = "";
        renderTZList();
        tzSearch.focus();
      }

      function closeTZModal(): void {
        tzBackdrop.classList.add("hidden");
      }

      tzNoteEl.addEventListener("click", (e) => {
        e.stopPropagation();
        if (tzBackdrop.classList.contains("hidden")) {
          openTZModal();
        } else {
          closeTZModal();
        }
      });

      tzSearch.addEventListener("input", () => {
        renderTZList(tzSearch.value);
      });

      // Close when clicking the backdrop (outside the popover)
      tzBackdrop.addEventListener("click", (e) => {
        if (e.target === tzBackdrop) {
          closeTZModal();
        }
      });

      // Close on Escape
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !tzBackdrop.classList.contains("hidden")) {
          closeTZModal();
        }
      });

      /* ── Gradient background ───────────────────────────────────────── */
      const initialPeak = isPeakHours();
      const gradient = new GradientCanvas(canvasEl, initialPeak);

      /* ── UI helpers ────────────────────────────────────────────────── */
      const UI = {
        PEAK: {
          label: "DeepSeek API",
          heading: "Peak hours",
        },
        OFF: {
          label: "DeepSeek API",
          heading: "Off hours",
        },
      } as const;

      function updateUI(peak: boolean): void {
        const state = peak ? UI.PEAK : UI.OFF;
        labelEl.textContent = state.label;
        headingEl.textContent = state.heading;
      }

      function updateCountdown(): void {
        const info = getCountdownInfo();
        if (info.nextState === "peak") {
          countdownLabelEl.textContent = "Time until peak hours";
          countdownEl.classList.remove("countdown-off");
          countdownEl.classList.add("countdown-peak");
        } else {
          countdownLabelEl.textContent = "Time until off hours";
          countdownEl.classList.remove("countdown-peak");
          countdownEl.classList.add("countdown-off");
        }
        countdownTimeEl.textContent = formatCountdown(info.secondsUntil);
      }

      /* ── Main loop ─────────────────────────────────────────────────── */
      let currentPeak = initialPeak;

      function tick(): void {
        const peak = isPeakHours();

        if (peak !== currentPeak) {
          currentPeak = peak;
          gradient.setPeak(peak);
          updateUI(peak);
        }

        clockEl.textContent = `UTC time: ${getUtcTimeString()}`;
        localClockEl.textContent = `Local time: ${getLocalTimeString()}`;
        localPeakEl.textContent = getLocalPeakHoursString();
        updateCountdown();
        gradient.tick();
        requestAnimationFrame(tick);
      }

      /* ── Boot ──────────────────────────────────────────────────────── */
      window.addEventListener("resize", () => {
        gradient.resize();
        gradient.initOrbs();
      });

      buildTimezoneList();
      updateUI(initialPeak);
      tzNoteEl.textContent = getLocalTZString();
      tick();
    </script>
  </body>
</html>
